<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/daily_ayah_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/daily_ayah_widget_background">
    <TextView
        android:id="@+id/daily_ayah_arabic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="right"
        android:textSize="20sp"
        android:textColor="#1C1B1F"
        android:maxLines="6"
        android:ellipsize="end" />
    <TextView
        android:id="@+id/daily_ayah_translation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="4"
        android:ellipsize="end"
        android:textColor="#49454F"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/daily_ayah_reference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#2D5A43"
        android:textStyle="bold"
        android:textSize="11sp" />
</LinearLayout>
